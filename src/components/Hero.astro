---
// Hero.astro - Home hero (Figma: "Home - Sketch Portfolio" #9:145)
import Button from "./Button.astro";
import data from "../data/data.json";

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = data.translations[lang];

const nameParts = data.profile.name.split(" ");
const firstNameLine = nameParts.slice(0, -1).join(" ");
const lastName = nameParts[nameParts.length - 1];
---

<section id="home" class="hero-section reveal-scroll">
  <svg
    class="hero-scribble"
    width="128"
    height="128"
    viewBox="0 0 128 128"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="64"
      cy="64"
      r="62"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-dasharray="6 6"
      opacity="0.2"></circle>
  </svg>

  <div class="hero-layout">
    <div class="hero-content">
      <h1 class="hero-title">
        {t.hero.greeting}<br />
        <span class="hero-name-highlight">{firstNameLine}<br />{lastName}</span>
        <br />
        {t.hero.line1}<br />
        {t.hero.line2}<br />
        {t.hero.line3}
      </h1>

      <p class="hero-subtitle">
        {t.hero.subtitle}
      </p>

      <div class="hero-actions">
        <Button href="#projects" variant="primary" size="lg">
          {t.hero.viewProjects}
          <svg
            width="16"
            height="12"
            viewBox="0 0 16 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 6h13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
            <path
              d="M10 1.5L14.5 6 10 10.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </Button>
        <Button href="#about" variant="link" size="nav"> {t.hero.learnMore} </Button>
      </div>
    </div>

    <div class="hero-sketch-card">
      <span class="corner-mark corner-tl" aria-hidden="true"></span>
      <span class="corner-mark corner-br" aria-hidden="true"></span>
      <img
        src={`${import.meta.env.BASE_URL}assets/hero_portrait.webp`}
        alt={t.hero.portraitAlt.replace('{name}', data.profile.name)}
        class="portrait-img"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 40px 0 0;
    position: relative;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 40px 0 0;
    }
  }

  .hero-scribble {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    width: 80px;
    height: 80px;
  }

  @media (min-width: 768px) {
    .hero-scribble {
      top: 40px;
      left: -24px;
      transform: none;
      width: 128px;
      height: 128px;
    }
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  @media (min-width: 900px) {
    .hero-layout {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
      text-align: left;
    }
  }

  .hero-title {
    font-family: var(--font-headline);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--primary);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3rem;
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  .hero-name-highlight {
    background-color: rgba(193, 241, 0, 0.5);
    border-radius: 2px;
    padding: 0 6px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--on-surface-variant);
    margin: 0 auto 1.5rem;
    max-width: 576px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: 1.25rem;
      line-height: 32px;
      margin-bottom: 2.5rem;
      text-align: left;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-sketch-card {
    position: relative;
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    background: var(--background);
    border-radius: 48px;
    padding: 10px;
    display: flex;
    justify-content: center;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .hero-sketch-card {
      max-width: 455px;
      border-radius: 135px 120px 120px 135px;
      padding: 16px;
    }
  }

  .corner-mark {
    position: absolute;
    width: 16.28px;
    height: 16.28px;
  }

  .corner-tl {
    top: 8.14px;
    left: 15.4px;
    border-top: 1px solid var(--primary);
    border-left: 1px solid var(--primary);
  }

  .corner-br {
    bottom: 8.14px;
    right: 15.4px;
    border-bottom: 1px solid var(--primary);
    border-right: 1px solid var(--primary);
  }

  .portrait-img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
    border-radius: 40px;
  }

  @media (min-width: 640px) {
    .portrait-img {
      height: 360px;
    }
  }

  @media (min-width: 900px) {
    .portrait-img {
      height: 500px;
      border-radius: 119px 104px 104px 119px;
    }
  }
</style>
