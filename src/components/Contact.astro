---
// Contact.astro - "Let's Talk" (Figma: "Contact - dyeye" #9:361)
import Button from "./Button.astro";
import data from "../data/data.json";

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = data.translations[lang];

const socialLinks = data.socialLinks.map((id) => data.links[id]);
const profile = data.profile;
const alertMessage = t.contact.alert.replace('{name}', profile.name);
---

<section id="contact" class="contact-section reveal-scroll">
  <div class="contact-grid">
    <div class="contact-left">
      <h2 class="contact-heading">{t.contact.heading}</h2>

      <div class="quote-wrap">
        <span class="quote-highlight" aria-hidden="true"></span>
        <p class="contact-quote">{t.contact.quote}</p>
      </div>

      <svg
        class="hand-drawn-arrow desktop-only"
        width="200"
        height="150"
        viewBox="0 0 200 150"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 34 C 80 14, 150 44, 158 112 M 138 98 L 158 112 L 166 92"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>

      <div class="socials">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.icon === "linkedin" ? (
                <svg
                  width="18"
                  height="20"
                  viewBox="0 0 18 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect
                    x="1"
                    y="1"
                    width="16"
                    height="18"
                    rx="3"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <path
                    d="M5.5 14V8.5M5.5 6v.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="8.5"
                    y="9"
                    width="4"
                    height="5"
                    rx="1"
                    fill="currentColor"
                  />
                </svg>
              ) : (
                <svg
                  width="20"
                  height="12"
                  viewBox="0 0 20 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 2l3.5 4-3.5 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                  <path
                    d="M10 2l3.5 4-3.5 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                  <path
                    d="M17.5 2l-3.5 4 3.5 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              )}
              {social.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="contact-right">
      <div class="form-block">
        <form
          class="contact-form"
          onsubmit="event.preventDefault(); alert('{alertMessage}');"
        >
          <div class="form-group">
            <label for="name" class="label-caps form-label">{t.contact.yourName}</label>
            <input
              type="text"
              id="name"
              required
              class="form-input"
              placeholder={profile.shortName}
            />
          </div>

          <div class="form-group">
            <label for="email" class="label-caps form-label">{t.contact.yourEmail}</label>
            <input
              type="email"
              id="email"
              required
              class="form-input"
              placeholder={profile.email}
            />
          </div>

          <div class="form-group">
            <label for="msg" class="label-caps form-label">{t.contact.message}</label>
            <textarea
              id="msg"
              rows="4"
              required
              class="form-input form-textarea"
              placeholder={t.contact.messagePlaceholder}></textarea>
          </div>

          <div class="form-submit-row">
            <Button type="submit" variant="display" size="xl">
              {t.contact.submit}
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1.5 8L14 2l-3.5 12.5L8 10 1.5 8z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  fill="none"></path>
                <path
                  d="M8 10L14 2"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"></path>
              </svg>
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 40px 0 30px;
  }

  @media (min-width: 768px) {
    .contact-section {
      padding: 120px 0 60px;
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
    text-align: center;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 5fr 6fr;
      column-gap: 48px;
      text-align: left;
    }
  }

  .contact-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 900px) {
    .contact-left {
      gap: 32px;
      align-items: flex-start;
      text-align: left;
    }
  }

  .contact-heading {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--primary);
    text-align: center;
  }

  @media (min-width: 768px) {
    .contact-heading {
      font-size: 4rem;
    }
  }

  .quote-wrap {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .quote-wrap {
      margin: 0;
    }
  }

  .quote-highlight {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 95%;
    max-width: 400px;
    height: 18px;
    background: rgba(193, 241, 0, 0.5);
    pointer-events: none;
  }

  .contact-quote {
    position: relative;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--on-surface-variant);
    margin: 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .contact-quote {
      font-size: 1.25rem;
      line-height: 32px;
    }
  }

  .hand-drawn-arrow {
    align-self: flex-end;
    margin-right: 40px;
    opacity: 0.8;
    transition: transform 0.3s ease;
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-only {
      display: block;
    }
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }

  @media (min-width: 900px) {
    .socials {
      justify-content: flex-start;
      gap: 24px;
      margin-top: auto;
    }
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-surface-variant);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--primary);
  }

  .contact-right {
    display: flex;
    align-items: stretch;
  }

  .form-block {
    position: relative;
    flex: 1;
    background: var(--surface-container-low);
    border-radius: 12px;
    padding: 16px;
  }

  @media (min-width: 768px) {
    .form-block {
      border-radius: 14px;
      padding: 24px;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0;
    align-items: center;
  }

  @media (min-width: 768px) {
    .contact-form {
      gap: 48px;
      padding: 0 8px;
      align-items: stretch;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    align-items: center;
  }

  @media (min-width: 768px) {
    .form-group {
      align-items: flex-start;
    }
  }

  .form-label {
    color: var(--primary);
    font-size: 0.6875rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .form-label {
      font-size: 0.75rem;
      text-align: left;
    }
  }

  .form-input {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 8px 10px;
    background: var(--card-bg);
    border: none;
    outline: none;
    color: var(--primary);
    width: 100%;
    border-radius: 4px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .form-input {
      font-size: 1.25rem;
      padding: 11px 12px;
      border-radius: 0;
      text-align: left;
    }
  }

  .form-input::placeholder {
    color: var(--on-surface-variant-soft);
  }

  .form-input:focus {
    box-shadow: 0 0 0 2px var(--lime-accent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  @media (min-width: 768px) {
    .form-textarea {
      min-height: 132px;
    }
  }

  .form-submit-row {
    display: flex;
    justify-content: center;
    padding-top: 8px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .form-submit-row {
      justify-content: flex-start;
      padding-top: 16px;
    }
  }
</style>
