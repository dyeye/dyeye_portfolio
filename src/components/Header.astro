---
// Header.astro - Single-row desktop | Hamburger mobile
import NavLink from "./NavLink.astro";
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import data from "../data/data.json";
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = data.translations[lang];
const enURL = getRelativeLocaleUrl('en', '/');
const esURL = getRelativeLocaleUrl('es', '/');
---

<header class="top-navbar">
  <a href="#" class="brand-logo">{data.profile.aka}</a>

  <nav class="nav-center" aria-label="Main">
    {
      data.navLinks.map((link) => (
        <NavLink
          href={link.href}
          label={t.nav[link.dataNav as keyof typeof t.nav]}
          dataNav={link.dataNav}
          isActive={link.dataNav === "home"}
        />
      ))
    }
  </nav>

  <div class="nav-end">
    <Button href="#contact" variant="ghost" size="md">{t.hireMe}</Button>
    <div class="lang-switch" role="group" aria-label="Language">
      <a
        href={enURL}
        class:list={{ "lang-link": true, active: lang === "en" }}
        aria-current={lang === "en" ? "true" : undefined}
      >
        EN
      </a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a
        href={esURL}
        class:list={{ "lang-link": true, active: lang === "es" }}
        aria-current={lang === "es" ? "true" : undefined}
      >
        ES
      </a>
    </div>
    <ThemeToggle />
    <button
      class="hamburger"
      id="menu-toggle"
      type="button"
      aria-label={t.openMenu}
      aria-expanded="false"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

<div class="mobile-overlay" id="mobile-overlay">
  <nav class="mobile-nav">
    {
      data.navLinks.map((link) => (
        <a href={link.href} class="mobile-link" data-nav={link.dataNav}>
          {link.label}
        </a>
      ))
    }
    <div class="mobile-bottom">
      <Button href="#contact" variant="primary" size="lg">{t.hireMe}</Button>
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById("menu-toggle");
  const overlay = document.getElementById("mobile-overlay");
  const backdrop = document.getElementById("mobile-backdrop");
  const navbar = document.querySelector(".top-navbar");

  // Scroll-lock via overflow:hidden on <html> (keeps the document height intact
  // so Lenis still measures the correct scroll limit; position:fixed collapsed it)
  const openMenu = () => {
    overlay?.classList.add("open");
    backdrop?.classList.add("open");
    btn?.classList.add("active");
    btn?.setAttribute("aria-expanded", "true");
    document.documentElement.classList.add("menu-locked");
  };

  const closeMenu = () => {
    overlay?.classList.remove("open");
    backdrop?.classList.remove("open");
    btn?.classList.remove("active");
    btn?.setAttribute("aria-expanded", "false");
    document.documentElement.classList.remove("menu-locked");
  };

  btn?.addEventListener("click", () => {
    if (overlay?.classList.contains("open")) closeMenu();
    else openMenu();
  });

  backdrop?.addEventListener("click", closeMenu);

  overlay?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", closeMenu),
  );

  // If the viewport grows past mobile while the menu is open, close it
  window.addEventListener("resize", () => {
    if (window.innerWidth > 767 && btn?.getAttribute("aria-expanded") === "true") {
      closeMenu();
    }
  });

  // Hide on scroll down, reveal on scroll up (skip near the top / menu open)
  let lastY = window.scrollY;

  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      const menuOpen = overlay?.classList.contains("open");
      if (menuOpen || y <= 80) {
        navbar?.classList.remove("hidden");
      } else if (y > lastY + 6) {
        navbar?.classList.add("hidden");
      } else if (y < lastY - 4) {
        navbar?.classList.remove("hidden");
      }
      lastY = y;
    },
    { passive: true },
  );
</script>

<style>
  .top-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 2px dashed var(--primary);
    max-width: 100%;
    margin: 0 auto;
    padding: 14px var(--page-gutter);
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 24px;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .top-navbar.hidden {
    transform: translateY(-100%);
  }

  .brand-logo {
    font-family: var(--font-headline);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-logo:hover {
    transform: scale(1.03);
  }

  .nav-center {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  .nav-end {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--on-surface-variant-soft);
  }

  .lang-link {
    color: var(--on-surface-variant-soft);
    text-decoration: none;
    padding: 2px 4px;
    transition: color 0.2s ease;
  }

  .lang-link:hover {
    color: var(--primary);
  }

  .lang-link.active {
    color: var(--primary);
    border-bottom: 2px solid var(--lime-accent);
  }

  .lang-sep {
    opacity: 0.5;
  }

  /* Hamburger — hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 7px;
    background: transparent;
    border: 1.5px solid var(--primary);
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    z-index: 1010;
  }

  .bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .hamburger.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.active .bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile overlay — hidden on desktop */
  .mobile-overlay,
  .mobile-backdrop {
    display: none;
  }

  /* ── Mobile (< 768px) ── */
  @media (max-width: 767px) {
    .top-navbar {
      padding: 10px var(--page-gutter);
    }

    .nav-center {
      display: none !important;
    }

    /* Hide HIRE ME button on mobile, keep toggle + hamburger */
    .nav-end :global(.btn) {
      display: none;
    }

    .brand-logo {
      flex: 1;
      font-size: 1.75rem;
    }

    .hamburger {
      display: flex;
    }

    .mobile-overlay {
      display: block;
      position: fixed;
      top: 0;
      right: 0;
      width: 50%;
      height: 100vh;
      background: var(--background);
      border-left: 2px dashed var(--primary);
      z-index: 999;
      transform: translateX(100%);
      visibility: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      transition:
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0.3s ease;
    }

    .mobile-overlay.open {
      transform: translateX(0);
      visibility: visible;
    }

    .mobile-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.25);
      z-index: 998;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
    }

    .mobile-backdrop.open {
      opacity: 1;
      visibility: visible;
    }

    .mobile-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      height: 100%;
      padding: 72px 24px 40px;
    }

    .mobile-link {
      font-family: var(--font-body);
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--primary);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: color 0.2s ease;
    }

    .mobile-link:hover {
      color: var(--lime-accent);
    }

    .mobile-bottom {
      margin-top: 1px;
    }
  }
</style>
