---
// Footer.astro - Site footer (Figma: EL-73754d1f)
import data from "../data/data.json";

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = data.translations[lang];

const footerLinks = data.footerLinks.map((id) => data.links[id]);
---

<footer class="site-footer">
  <div class="footer-container">
    <a href="#" class="brand-logo">{data.profile.aka}</a>
    <p class="footer-copy">
      {t.footer.copy
        .replace('{year}', String(new Date().getFullYear()))
        .replace('{name}', data.profile.name)}
    </p>
    <div class="footer-links">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="footer-link"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px dashed var(--primary);
    background: var(--background);
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .site-footer {
      margin-top: 120px;
    }
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px var(--page-gutter);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
      gap: 1.5rem;
      padding: 24px var(--page-gutter);
    }
  }

  .brand-logo {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .brand-logo {
      font-size: 2rem;
    }
  }

  .footer-copy {
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--on-surface-variant);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-copy {
      font-size: 1rem;
      text-align: left;
    }
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .footer-links {
      gap: 16px;
    }
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--on-surface-variant);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (min-width: 768px) {
    .footer-link {
      font-size: 1rem;
    }
  }

  .footer-link:hover {
    color: var(--primary);
  }
</style>
