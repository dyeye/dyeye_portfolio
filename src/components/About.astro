---
// About.astro - Split layout photo + story (Figma: "Section: Split Layout" #9:215)
// Left column renders the GitHub profile README (fetched at build time) in sketchy style.
import data from '../data/data.json';
import { marked } from 'marked';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = data.translations[lang];

const readmeRepo =
  data.profile.readmeRepo ??
  `${data.profile.githubUsername}/${data.profile.githubUsername}`;

async function fetchReadme(repo: string): Promise<string | null> {
  for (const branch of ['main', 'master']) {
    try {
      const res = await fetch(
        `https://raw.githubusercontent.com/${repo}/${branch}/README.md`,
      );
      if (res.ok) return await res.text();
    } catch {
      // try next branch
    }
  }
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/readme`, {
      headers: {
        Accept: 'application/vnd.github.raw+json',
        'User-Agent': 'dyeye-portfolio',
      },
    });
    if (res.ok) return await res.text();
  } catch {
    // fall back to placeholder
  }
  return null;
}

const readmeMarkdown = await fetchReadme(readmeRepo);
const readmeHtml = readmeMarkdown
  ? marked.parse(readmeMarkdown, { gfm: true, async: false })
  : null;
---

<div class="about-top-grid reveal-scroll">
  <div class="readme-col">
    <div class="readme-dashed-border" aria-hidden="true"></div>
    <div class="readme-frame">
      {readmeHtml ? (
        <div class="readme-content" set:html={readmeHtml} />
      ) : (
        <p class="readme-fallback">
          {t.about.readmeFallback1} <strong>{readmeRepo}</strong>{t.about.readmeFallback2}
        </p>
      )}
    </div>
  </div>

  <div class="bio-content">
    <h2 class="about-title">
      {t.about.titlePrefix}
      <span class="about-title-word">
        <span class="lime-swipe" aria-hidden="true"></span>
        {t.about.titleWord}
      </span>
    </h2>

    <p class="text-body-lg about-paragraph">
      {t.about.paragraph1}
    </p>

    <p class="text-body-lg about-paragraph about-paragraph-muted">
      {t.about.paragraph2}
    </p>

    <div class="status-underline label-caps">
      {t.about.status}
    </div>
  </div>
</div>

<style>
  .about-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 40px;
  }

  @media (min-width: 900px) {
    .about-top-grid {
      grid-template-columns: 5fr 7fr;
      column-gap: 24px;
      margin-bottom: 120px;
    }
  }

  .readme-col {
    position: relative;
    width: 100%;
    justify-self: center;
    overflow: hidden;
    padding-right: 6px;
    padding-bottom: 6px;
  }

  @media (min-width: 768px) {
    .readme-col {
      overflow: visible;
      padding-right: 0;
      padding-bottom: 0;
    }
  }

  .readme-dashed-border {
    position: absolute;
    top: 6px;
    left: 6px;
    right: -6px;
    bottom: -6px;
    border: 2px dashed var(--primary);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .readme-dashed-border {
      top: 16px;
      left: 16px;
      right: -16px;
      bottom: -16px;
    }
  }

  .readme-frame {
    position: relative;
    border: 2px solid var(--primary);
    background: var(--card-bg);
    max-height: 380px;
    overflow-y: auto;
    padding: 20px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .readme-frame {
      max-height: 560px;
      padding: 32px 32px 40px;
      text-align: left;
    }
  }

  .readme-content {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 26px;
    color: var(--on-surface-variant);
    text-align: center;
  }

  @media (min-width: 768px) {
    .readme-content {
      font-size: 1rem;
      line-height: 28px;
      text-align: left;
    }
  }

  .readme-content > :first-child {
    margin-top: 0;
  }

  .readme-content > :last-child {
    margin-bottom: 0;
  }

  .readme-content h1,
  .readme-content h2,
  .readme-content h3,
  .readme-content h4 {
    font-family: var(--font-headline);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--primary);
    line-height: 1.2;
    text-align: center;
  }

  @media (min-width: 768px) {
    .readme-content h1,
    .readme-content h2,
    .readme-content h3,
    .readme-content h4 {
      text-align: left;
    }
  }

  .readme-content h1 {
    font-size: 1.5rem;
    margin: 16px 0 8px;
  }

  .readme-content h2 {
    font-size: 1.25rem;
    margin: 14px 0 8px;
    border-bottom: 2px dashed var(--primary);
    padding-bottom: 4px;
  }

  .readme-content p {
    margin: 8px 0;
  }

  .readme-content a {
    color: var(--primary);
    text-decoration: none;
    border-bottom: 2px solid var(--lime-accent);
  }

  .readme-content ul,
  .readme-content ol {
    padding-left: 0;
    list-style-position: inside;
    margin: 8px 0;
  }

  .readme-fallback {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 26px;
    color: var(--on-surface-variant);
    text-align: center;
  }

  .bio-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 0;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 900px) {
    .bio-content {
      gap: 24px;
      padding-left: 48px;
      align-items: flex-start;
      text-align: left;
    }
  }

  .about-title {
    font-family: var(--font-headline);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .about-title {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 900px) {
    .about-title {
      font-size: 5rem;
      align-items: flex-start;
      text-align: left;
    }
  }

  .about-title-word {
    position: relative;
    width: fit-content;
  }

  .lime-swipe {
    position: absolute;
    left: -4px;
    bottom: 2px;
    width: 108%;
    height: 50%;
    background: var(--lime-accent);
    z-index: -1;
  }

  .about-paragraph {
    color: var(--on-surface-variant);
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (min-width: 768px) {
    .about-paragraph {
      font-size: 1.25rem;
      text-align: left;
    }
  }

  .about-paragraph-muted {
    margin: 0;
  }

  .status-underline {
    border-bottom: 2px dashed var(--on-surface-variant);
    display: inline-block;
    padding-bottom: 4px;
    color: var(--on-surface-variant);
    width: fit-content;
    font-size: 0.75rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .status-underline {
      margin: 0;
    }
  }
</style>
