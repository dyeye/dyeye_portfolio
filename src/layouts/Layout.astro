---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/data.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${data.profile.aka} // ${data.profile.name} - ${data.profile.role}`,
  description = `Hand-Drawn & Architectural Portfolio of ${data.profile.name}, ${data.profile.role}.`,
} = Astro.props;
---

<!usr/bin/env html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = stored ? stored === 'dark' : systemDark.matches;
        root.setAttribute('data-theme', isDark ? 'dark' : 'light');

        function syncCheck() {
          var check = document.getElementById('theme-check');
          if (check) check.checked = root.getAttribute('data-theme') === 'dark';
        }

        document.addEventListener('change', function (e) {
          if (e.target && e.target.id === 'theme-check') {
            var next = e.target.checked ? 'dark' : 'light';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (err) {}
          }
        });

        document.addEventListener('DOMContentLoaded', syncCheck);

        systemDark.addEventListener('change', function (e) {
          try {
            if (!localStorage.getItem('theme')) {
              var next = e.matches ? 'dark' : 'light';
              root.setAttribute('data-theme', next);
              syncCheck();
            }
          } catch (err) {}
        });
      })();
    </script>
  </head>
  <body>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Lenis Smooth Scroll & Scroll Observer Script -->
    <script>
      import Lenis from 'lenis';

      document.addEventListener('DOMContentLoaded', () => {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = anchor.getAttribute('href');
            if (targetId === '#') {
              lenis.scrollTo(0);
            } else if (targetId) {
              const targetEl = document.querySelector(targetId);
              if (targetEl) {
                lenis.scrollTo(targetEl as HTMLElement, { offset: -70 });
              }
            }
          });
        });

        // IntersectionObserver for Entrance & Exit Scroll Reveal Animations
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.08
        };

        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              // Re-observe nested reveal-scroll children after parent becomes visible
              const nested = entry.target.querySelectorAll('.reveal-scroll:not(.is-visible)');
              if (nested.length) {
                setTimeout(() => {
                  nested.forEach((child) => {
                    revealObserver.unobserve(child);
                    revealObserver.observe(child);
                  });
                }, 50);
              }
            } else {
              if (entry.boundingClientRect.top > 0) {
                entry.target.classList.remove('is-visible');
              }
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-scroll').forEach((el) => {
          revealObserver.observe(el);
        });

        // Active Navbar link indicator sync on scroll
        const sections = document.querySelectorAll('section[id]');
        const navItems = document.querySelectorAll('[data-nav]');

        const updateNav = () => {
          let current = 'home';
          sections.forEach((section) => {
            const sectionTop = (section as HTMLElement).offsetTop - 140;
            if (window.scrollY >= sectionTop) {
              current = section.getAttribute('id') || 'home';
            }
          });

          navItems.forEach((item) => {
            item.classList.remove('active');
            if (item.getAttribute('data-nav') === current) {
              item.classList.add('active');
            }
          });
        };

        window.addEventListener('scroll', updateNav);
        updateNav();
      });
    </script>
  </body>
</html>
